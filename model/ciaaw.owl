@prefix chemrof: <https://w3id.org/chemrof/> .
@prefix ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> a owl:Ontology ;
    rdfs:label "CIAAW draft vocabulary"@en ;
    rdfs:comment "The vocabulary of the CIAAW linked-data draft."@en .

ciaaw:AtomicMassDeclaration a owl:Class ;
    rdfs:label "Atomic mass declaration"@en ;
    rdfs:comment "Atomic mass of one isotope in Da, with standard uncertainty." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:subClassOf ciaaw:Declaration .

ciaaw:ConventionalAtomicWeightDeclaration a owl:Class ;
    rdfs:label "Conventional atomic weight declaration"@en ;
    rdfs:comment "Single abridged/conventional value for applications that do not need the interval." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:subClassOf ciaaw:Declaration .

ciaaw:currentAbundance a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "current abundance"@en ;
    dcam:domainIncludes chemrof:Isotope ;
    dcam:rangeIncludes ciaaw:IsotopicAbundanceDeclaration ;
    rdfs:comment "Isotope -> the one non-deprecated abundance declaration." ;
    rdfs:domain chemrof:Isotope ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range ciaaw:IsotopicAbundanceDeclaration .

ciaaw:currentStandardAtomicWeight a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "current standard atomic weight"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes ciaaw:StandardAtomicWeightDeclaration ;
    rdfs:comment "Element -> the one non-deprecated standard declaration. Modelled after dcat:hasCurrentVersion." ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range ciaaw:StandardAtomicWeightDeclaration .

ciaaw:footnote a owl:ObjectProperty ;
    rdfs:label "footnote"@en ;
    dcam:domainIncludes ciaaw:IsotopicAbundanceDeclaration,
        ciaaw:StandardAtomicWeightDeclaration ;
    dcam:rangeIncludes ciaaw:Footnote ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range ciaaw:Footnote .

ciaaw:hasDeclaration a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has declaration"@en ;
    dcam:domainIncludes chemrof:ChemicalElement,
        chemrof:Isotope ;
    dcam:rangeIncludes ciaaw:IsotopicAbundanceDeclaration,
        ciaaw:StandardAtomicWeightDeclaration ;
    rdfs:comment "Element or isotope -> ALL its declarations incl. deprecated (history)." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> .

ciaaw:hasIsotope a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has isotope"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes chemrof:Isotope ;
    rdfs:comment "Element -> isotope." ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range chemrof:Isotope .

ciaaw:longestLivedMassNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "longest lived mass number"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:comment "Element without stable isotopes: mass number of the longest-lived isotope as bracketed in the CIAAW table." ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:massNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "mass number"@en ;
    dcam:domainIncludes chemrof:Isotope ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:domain chemrof:Isotope ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:ofElement a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "of element"@en ;
    dcam:domainIncludes ciaaw:StandardAtomicWeightDeclaration ;
    dcam:rangeIncludes chemrof:ChemicalElement ;
    rdfs:comment "Declaration -> element it is about." ;
    rdfs:domain ciaaw:StandardAtomicWeightDeclaration ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range chemrof:ChemicalElement .

ciaaw:ofIsotope a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "of isotope"@en ;
    dcam:domainIncludes ciaaw:IsotopicAbundanceDeclaration ;
    dcam:rangeIncludes chemrof:Isotope ;
    rdfs:comment "Isotope declaration -> isotope it is about." ;
    rdfs:domain ciaaw:IsotopicAbundanceDeclaration ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range chemrof:Isotope .

ciaaw:significantFigures a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "significant figures"@en ;
    dcam:domainIncludes qudt:QuantityValue ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:comment "Needed because xsd:decimal drops trailing zeros (1.0080 = 1.008)." ;
    rdfs:domain qudt:QuantityValue ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:significantFiguresLower a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "significant figures lower"@en ;
    dcam:domainIncludes qudt:QuantityValue ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:domain qudt:QuantityValue ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:significantFiguresUncertainty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "significant figures uncertainty"@en ;
    dcam:domainIncludes qudt:QuantityValue ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:comment "Number of digits in the bracketed uncertainty, e.g. 3 for 0.969 41(156)." ;
    rdfs:domain qudt:QuantityValue ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:significantFiguresUpper a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "significant figures upper"@en ;
    dcam:domainIncludes qudt:QuantityValue ;
    dcam:rangeIncludes xsd:integer ;
    rdfs:domain qudt:QuantityValue ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:integer .

ciaaw:standardAtomicWeightLower a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "standard atomic weight lower"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes xsd:decimal ;
    rdfs:comment "Derived shortcut copied from the current declaration; never edited by hand." ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:decimal .

ciaaw:standardAtomicWeightUncertainty a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "standard atomic weight uncertainty"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes xsd:decimal ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:decimal .

ciaaw:standardAtomicWeightUpper a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "standard atomic weight upper"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes xsd:decimal ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:decimal .

ciaaw:standardAtomicWeightValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "standard atomic weight value"@en ;
    dcam:domainIncludes chemrof:ChemicalElement ;
    dcam:rangeIncludes xsd:decimal ;
    rdfs:domain chemrof:ChemicalElement ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range xsd:decimal .

ciaaw:value a owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "value"@en ;
    dcam:domainIncludes ciaaw:IsotopicAbundanceDeclaration,
        ciaaw:StandardAtomicWeightDeclaration ;
    dcam:rangeIncludes qudt:QuantityValue ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:range qudt:QuantityValue .

ciaaw:Footnote a owl:Class ;
    rdfs:label "Footnote"@en ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> .

ciaaw:Declaration a owl:Class ;
    rdfs:label "Declaration"@en ;
    rdfs:comment "One immutable, citable assignment of a value by CIAAW. Never edited after publication, only deprecated." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> .

ciaaw:IsotopicAbundanceDeclaration a owl:Class ;
    rdfs:label "Isotopic abundance declaration"@en ;
    rdfs:comment "Representative isotopic composition (amount fraction) of one isotope." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:subClassOf ciaaw:Declaration .

ciaaw:StandardAtomicWeightDeclaration a owl:Class ;
    rdfs:label "Standard atomic weight declaration"@en ;
    rdfs:comment "Ar°(E): either an interval (lowerBound/upperBound) or value with standardUncertainty." ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    rdfs:subClassOf ciaaw:Declaration .
