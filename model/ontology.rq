PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcam: <http://purl.org/dc/dcam/>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX chemrof: <https://w3id.org/chemrof/>
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>

CONSTRUCT {
  <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> a owl:Ontology ;
    rdfs:label "CIAAW draft vocabulary"@en ;
    rdfs:comment "The vocabulary of the CIAAW linked-data draft."@en .

  ?class a owl:Class ;
    rdfs:label ?classLabel ;
    rdfs:comment ?classComment ;
    rdfs:subClassOf ?superClass ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> .

  ?objectProperty a owl:ObjectProperty ;
    rdfs:label ?objectLabel ;
    rdfs:comment ?objectComment ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    dcam:domainIncludes ?objectDomainIncludes ;
    dcam:rangeIncludes ?objectRangeIncludes ;
    rdfs:domain ?objectDomain ;
    rdfs:range ?objectRange .

  ?datatypeProperty a owl:DatatypeProperty ;
    rdfs:label ?datatypeLabel ;
    rdfs:comment ?datatypeComment ;
    rdfs:isDefinedBy <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft> ;
    dcam:domainIncludes ?datatypeDomainIncludes ;
    dcam:rangeIncludes ?datatypeRangeIncludes ;
    rdfs:domain ?datatypeDomain ;
    rdfs:range ?datatypeRange .

  ?functional a owl:FunctionalProperty .
  ?inverseFunctional a owl:InverseFunctionalProperty .
}
WHERE {
  {
    { SELECT DISTINCT ?class WHERE {
        { ?instance a ?class } UNION { ?class a rdfs:Class } UNION { ?class rdfs:subClassOf ?other } UNION { ?other rdfs:subClassOf ?class }
        FILTER(STRSTARTS(STR(?class), STR(ciaaw:)))
    } }
    OPTIONAL { ?class rdfs:comment ?classComment }
    OPTIONAL { ?class rdfs:subClassOf ?superClass }
    BIND(LCASE(REPLACE(REPLACE(STRAFTER(STR(?class), STR(ciaaw:)), "([a-z])([A-Z])", "$1 $2"), "_", " ")) AS ?classWords)
    BIND(STRLANG(CONCAT(UCASE(SUBSTR(?classWords, 1, 1)), SUBSTR(?classWords, 2)), "en") AS ?classLabel)
  }
  UNION
  {
    { SELECT DISTINCT ?objectProperty WHERE {
        ?subject ?objectProperty ?object .
        FILTER(!isLiteral(?object) && STRSTARTS(STR(?objectProperty), STR(ciaaw:)))
    } }
    OPTIONAL { ?objectProperty rdfs:comment ?objectComment }
    OPTIONAL { SELECT DISTINCT ?objectProperty ?objectDomainIncludes WHERE { ?subject ?objectProperty ?object ; a ?objectDomainIncludes FILTER(!isLiteral(?object)) } }
    OPTIONAL { SELECT DISTINCT ?objectProperty ?objectRangeIncludes WHERE { ?subject ?objectProperty ?object . ?object a ?objectRangeIncludes } }
    OPTIONAL { SELECT ?objectProperty (SAMPLE(?type) AS ?objectDomain) WHERE { ?subject ?objectProperty ?object ; a ?type FILTER(!isLiteral(?object)) } GROUP BY ?objectProperty HAVING (COUNT(DISTINCT ?type) = 1) }
    OPTIONAL { SELECT ?objectProperty (SAMPLE(?type) AS ?objectRange) WHERE { ?subject ?objectProperty ?object . ?object a ?type } GROUP BY ?objectProperty HAVING (COUNT(DISTINCT ?type) = 1) }
    BIND(STRLANG(LCASE(REPLACE(REPLACE(STRAFTER(STR(?objectProperty), STR(ciaaw:)), "([a-z])([A-Z])", "$1 $2"), "_", " ")), "en") AS ?objectLabel)
  }
  UNION
  {
    { SELECT DISTINCT ?datatypeProperty WHERE {
        ?subject ?datatypeProperty ?object .
        FILTER(isLiteral(?object) && STRSTARTS(STR(?datatypeProperty), STR(ciaaw:)))
    } }
    OPTIONAL { ?datatypeProperty rdfs:comment ?datatypeComment }
    OPTIONAL { SELECT DISTINCT ?datatypeProperty ?datatypeDomainIncludes WHERE { ?subject ?datatypeProperty ?object ; a ?datatypeDomainIncludes FILTER(isLiteral(?object)) } }
    OPTIONAL { SELECT DISTINCT ?datatypeProperty (DATATYPE(?object) AS ?datatypeRangeIncludes) WHERE { ?subject ?datatypeProperty ?object FILTER(isLiteral(?object)) } }
    OPTIONAL { SELECT ?datatypeProperty (SAMPLE(?type) AS ?datatypeDomain) WHERE { ?subject ?datatypeProperty ?object ; a ?type FILTER(isLiteral(?object)) } GROUP BY ?datatypeProperty HAVING (COUNT(DISTINCT ?type) = 1) }
    OPTIONAL { SELECT ?datatypeProperty (SAMPLE(?datatype) AS ?datatypeRange) WHERE { ?subject ?datatypeProperty ?object FILTER(isLiteral(?object)) BIND(DATATYPE(?object) AS ?datatype) } GROUP BY ?datatypeProperty HAVING (COUNT(DISTINCT ?datatype) = 1) }
    BIND(STRLANG(LCASE(REPLACE(REPLACE(STRAFTER(STR(?datatypeProperty), STR(ciaaw:)), "([a-z])([A-Z])", "$1 $2"), "_", " ")), "en") AS ?datatypeLabel)
  }
  UNION
  {
    SELECT ?functional WHERE {
      { SELECT ?functional ?graph ?subject (COUNT(?object) AS ?values) WHERE {
          GRAPH ?graph { ?subject ?functional ?object }
          FILTER(STRSTARTS(STR(?functional), STR(ciaaw:)))
      } GROUP BY ?functional ?graph ?subject }
    } GROUP BY ?functional HAVING (MAX(?values) = 1)
  }
  UNION
  {
    SELECT ?inverseFunctional WHERE {
      { SELECT ?inverseFunctional ?graph ?object (COUNT(?subject) AS ?subjects) WHERE {
          GRAPH ?graph { ?subject ?inverseFunctional ?object }
          FILTER(!isLiteral(?object) && STRSTARTS(STR(?inverseFunctional), STR(ciaaw:)))
      } GROUP BY ?inverseFunctional ?graph ?object }
    } GROUP BY ?inverseFunctional HAVING (MAX(?subjects) = 1)
  }
}
