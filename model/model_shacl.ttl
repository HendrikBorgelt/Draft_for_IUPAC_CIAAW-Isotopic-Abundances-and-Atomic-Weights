    sh:targetClass ciaaw:Declaration ;
    sh:message "A declaration gives an interval, a value with its standard uncertainty, or a value alone: exactly one of them." ;
    sh:xone ( shape:IntervalForm shape:ValueWithUncertaintyForm shape:SingleValueForm ) .

shape:IntervalForm a sh:NodeShape ;
    rdfs:label "Interval" ;
    sh:property [ sh:path ciaaw:hasLowerBound ; sh:minCount 1 ] , [ sh:path ciaaw:hasUpperBound ; sh:minCount 1 ] ,
        [ sh:path ciaaw:hasValue ; sh:maxCount 0 ] , [ sh:path ciaaw:hasStandardUncertainty ; sh:maxCount 0 ] .

shape:ValueWithUncertaintyForm a sh:NodeShape ;
    rdfs:label "Value with standard uncertainty" ;
    sh:property [ sh:path ciaaw:hasValue ; sh:minCount 1 ] , [ sh:path ciaaw:hasStandardUncertainty ; sh:minCount 1 ] ,
        [ sh:path ciaaw:hasLowerBound ; sh:maxCount 0 ] , [ sh:path ciaaw:hasUpperBound ; sh:maxCount 0 ] .

shape:SingleValueForm a sh:NodeShape ;
    rdfs:label "Value alone" ;
    sh:property [ sh:path ciaaw:hasValue ; sh:minCount 1 ] , [ sh:path ciaaw:hasStandardUncertainty ; sh:maxCount 0 ] ,
        [ sh:path ciaaw:hasLowerBound ; sh:maxCount 0 ] , [ sh:path ciaaw:hasUpperBound ; sh:maxCount 0 ] .

shape:BoundsInOrder a sh:NodeShape ;
    rdfs:label "Bounds are in order" ;
    sh:targetSubjectsOf ciaaw:hasLowerBound ;
    sh:property shape:BoundsInOrder-check .

shape:BoundsInOrder-check a sh:PropertyShape ;
    sh:path ciaaw:hasLowerBound ;
    sh:lessThanOrEquals ciaaw:hasUpperBound ;
    sh:message "The lower bound must not exceed the upper bound." .

shape:UncertaintyIsPositive a sh:NodeShape ;
    rdfs:label "Uncertainty is positive" ;
    sh:targetSubjectsOf ciaaw:hasStandardUncertainty ;
    sh:property shape:UncertaintyIsPositive-check .

shape:UncertaintyIsPositive-check a sh:PropertyShape ;
    sh:path ciaaw:hasStandardUncertainty ;
    sh:minExclusive 0 ;
    sh:message "A standard uncertainty must be greater than zero." .

shape:AbundanceIsAFraction a sh:NodeShape ;
    rdfs:label "Abundance is a fraction" ;
    sh:targetClass ciaaw:IsotopicAbundanceDeclaration ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "An isotopic abundance must lie between 0 and 1, found {?value}." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasLowerBound|ciaaw:hasUpperBound|ciaaw:hasValue ?value .
                FILTER (?value < 0 || ?value > 1)
            }""" ] .

# --- Elements and isotopes -----------------------------------------------------------------------------------------

shape:IsotopeBelongsToOneElement a sh:NodeShape ;
    rdfs:label "Isotope belongs to one element" ;
    sh:targetClass ciaaw:Isotope ;
    sh:property shape:IsotopeBelongsToOneElement-check .

shape:IsotopeBelongsToOneElement-check a sh:PropertyShape ;
    sh:path [ sh:inversePath ciaaw:hasIsotope ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An isotope must belong to exactly one element." .

shape:CurrentIsInHistory a sh:NodeShape ;
    rdfs:label "Current declaration is part of the history" ;
    sh:targetClass ciaaw:ChemicalElement, ciaaw:Isotope ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "The current declaration {?value} is missing from ciaaw:hasDeclaration." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasCurrentStandardAtomicWeight|ciaaw:hasCurrentConventionalAtomicWeight|ciaaw:hasCurrentAbundance|ciaaw:hasCurrentAtomicMass ?value .
                FILTER NOT EXISTS { $this ciaaw:hasDeclaration ?value }
            }""" ] .

shape:DeclarationPointsBack a sh:NodeShape ;
    rdfs:label "Declaration points back to its subject" ;
    sh:targetClass ciaaw:ChemicalElement, ciaaw:Isotope ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "Declaration {?value} does not point back with ciaaw:isDeclarationOf." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasDeclaration ?value .
                FILTER NOT EXISTS { ?value ciaaw:isDeclarationOf $this }
            }""" ] .

# --- History -------------------------------------------------------------------------------------------------------

shape:CurrentIsPointedTo a sh:NodeShape ;
    rdfs:label "A current declaration is the current one of its subject" ;
    sh:targetClass ciaaw:Declaration ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "The declaration has the status current, but its subject {?value} does not point to it as current." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasStatus "current" ; ciaaw:isDeclarationOf ?value .
                FILTER NOT EXISTS { ?value ciaaw:hasCurrentStandardAtomicWeight|ciaaw:hasCurrentConventionalAtomicWeight|ciaaw:hasCurrentAbundance|ciaaw:hasCurrentAtomicMass $this }
            }""" ] .

shape:SupersededHasNext a sh:NodeShape ;
    rdfs:label "Superseded and only superseded declarations have a next one" ;
    sh:targetClass ciaaw:Declaration ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "A superseded declaration must name the next declaration, and a current one must not." ;
        sh:select """
            SELECT $this WHERE {
                { $this ciaaw:hasStatus "superseded" . FILTER NOT EXISTS { $this ciaaw:hasNextDeclaration ?next } }
                UNION
                { $this ciaaw:hasStatus "current" ; ciaaw:hasNextDeclaration ?next }
            }""" ] .

shape:ChainIsMutual a sh:NodeShape ;
    rdfs:label "Previous and next links run both ways" ;
    sh:targetSubjectsOf ciaaw:hasNextDeclaration ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "{?value} must link back with ciaaw:hasPreviousDeclaration." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasNextDeclaration ?value .
                FILTER NOT EXISTS { ?value ciaaw:hasPreviousDeclaration $this }
            }""" ] .

shape:ChainStaysWithSubject a sh:NodeShape ;
    rdfs:label "A chain stays with one element or isotope" ;
    sh:targetSubjectsOf ciaaw:hasNextDeclaration ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "The next declaration {?value} is about another element or isotope." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this ciaaw:hasNextDeclaration ?value ; ciaaw:isDeclarationOf ?subject .
                FILTER NOT EXISTS { ?value ciaaw:isDeclarationOf ?subject }
            }""" ] .

shape:ValidityInOrder a sh:NodeShape ;
    rdfs:label "A declaration ends when the next one starts" ;
    sh:targetSubjectsOf ciaaw:hasEndValidity ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:message "The end of validity {?value} is before the start, or differs from the start of the next declaration." ;
        sh:select """
            SELECT $this ?value WHERE {
                {
                    $this ciaaw:hasEndValidity ?value ; ciaaw:hasStartValidity ?start .
                    FILTER (STR(?value) < STR(?start))
                } UNION {
                    $this ciaaw:hasEndValidity ?value ; ciaaw:hasNextDeclaration/ciaaw:hasStartValidity ?next .
                    FILTER (STR(?value) != STR(?next))
                }
            }""" ] .

shape:AbundancesSumToOne a sh:NodeShape ;
    rdfs:label "Abundances of an element sum to 1" ;
    sh:targetClass ciaaw:ChemicalElement ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:prefixes shape:prefixes ;
        sh:severity sh:Warning ;
        sh:message "The current abundances sum to {?value}, expected 1 within 0.0005." ;
        sh:select """
            SELECT $this ?value WHERE {
                {
                    SELECT $this (SUM(?amount) AS ?value) WHERE {
                        $this ciaaw:hasIsotope/ciaaw:hasCurrentAbundance/ciaaw:hasValue ?amount .
                    } GROUP BY $this
                }
                FILTER NOT EXISTS { $this ciaaw:hasIsotope/ciaaw:hasCurrentAbundance/ciaaw:hasLowerBound ?any }
                FILTER (ABS(?value - 1) > 0.0005)
            }""" ] .
