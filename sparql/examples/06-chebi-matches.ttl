@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:6_06-chebi-matches a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Matches to ChEBI
 Elements and isotopes that are linked to a ChEBI entry.""";
  rdfs:label "Matches to ChEBI";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?subject ?chebi WHERE {
  ?subject skos:closeMatch ?chebi .
}
ORDER BY ?subject""";
  schema:keywords "ChEBI", "matches" .
