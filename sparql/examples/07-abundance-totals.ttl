@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:7_07-abundance-totals a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Total abundance per element
 Adds up the isotopes of each element. Elements given as intervals are left out, because intervals have no meaningful sum.""";
  rdfs:label "Total abundance per element";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
SELECT ?symbol (SUM(?amount) AS ?total) WHERE {
  ?element ciaaw:hasSymbol ?symbol ;
    ciaaw:hasIsotope/ciaaw:hasCurrentAbundance/ciaaw:hasValue ?amount .
  MINUS {
    ?element ciaaw:hasIsotope/ciaaw:hasCurrentAbundance/ciaaw:hasLowerBound ?bound .
  }
}
GROUP BY ?symbol
ORDER BY ?symbol""";
  schema:keywords "abundance", "totals" .
