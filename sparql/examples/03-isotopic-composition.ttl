@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:3_03-isotopic-composition a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Isotopic composition of calcium
 The current abundance of each isotope, with the number of significant figures printed in the table.""";
  rdfs:label "Isotopic composition of calcium";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX ciaaw: <https://example.org/ciaaw-draft#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?massNumber ?abundance ?uncertainty ?significantFigures WHERE {
  ?element rdfs:label \"calcium\"@en ;
    ciaaw:hasIsotope ?isotope .
  ?isotope ciaaw:massNumber ?massNumber ;
    ciaaw:currentAbundance/ciaaw:value ?quantity .
  ?quantity qudt:numericValue ?abundance ;
    qudt:standardUncertainty ?uncertainty ;
    ciaaw:significantFigures ?significantFigures .
}
ORDER BY ?massNumber""";
  schema:keywords "abundance", "isotopes" .
