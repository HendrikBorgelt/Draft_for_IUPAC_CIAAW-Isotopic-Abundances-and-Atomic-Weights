@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:5_05-provenance a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Provenance of the hydrogen values
 Every declaration about hydrogen and its isotopes: its status, the year CIAAW recommended it, the report it comes from, and the documents it was read from.""";
  rdfs:label "Provenance of the hydrogen values";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?declaration ?status ?year ?doi ?source WHERE {
  ?element ciaaw:hasSymbol \"H\" ;
    ciaaw:hasDeclaration|ciaaw:hasIsotope/ciaaw:hasDeclaration ?declaration .
  ?declaration ciaaw:hasStatus ?status ;
    prov:wasDerivedFrom ?source .
  OPTIONAL { ?declaration ciaaw:hasStartValidity ?year }
  OPTIONAL { ?declaration ciaaw:hasDefiningReport/dcterms:identifier ?doi }
}
ORDER BY ?declaration ?source""";
  schema:keywords "declarations", "provenance" .
