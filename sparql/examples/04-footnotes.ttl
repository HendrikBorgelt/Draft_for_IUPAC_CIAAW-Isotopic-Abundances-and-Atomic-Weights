@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:4_04-footnotes a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Elements with footnote g
 Elements whose current standard atomic weight carries note g, for materials outside the limits for normal material.""";
  rdfs:label "Elements with footnote g";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?symbol ?name WHERE {
  ?element ciaaw:hasSymbol ?symbol ;
    ciaaw:hasAtomicNumber ?z ;
    rdfs:label ?name ;
    ciaaw:hasCurrentStandardAtomicWeight/ciaaw:hasFootnote/skos:notation \"g\" .
}
ORDER BY ?z""";
  schema:keywords "elements", "footnotes" .
