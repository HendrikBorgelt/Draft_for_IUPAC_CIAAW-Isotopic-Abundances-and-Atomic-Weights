@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:prefix_ciaaw sh:namespace "https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#"^^xsd:anyURI;
  sh:prefix "ciaaw" .

_:prefix_dcterms sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI;
  sh:prefix "dcterms" .

_:prefix_prov sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI;
  sh:prefix "prov" .

_:prefix_rdfs sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI;
  sh:prefix "rdfs" .

_:prefix_skos sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI;
  sh:prefix "skos" .

_:sparql_examples_prefixes a owl:Ontology;
  owl:imports <http://www.w3.org/ns/shacl#>;
  sh:declare _:prefix_ciaaw, _:prefix_dcterms, _:prefix_prov, _:prefix_rdfs, _:prefix_skos .
