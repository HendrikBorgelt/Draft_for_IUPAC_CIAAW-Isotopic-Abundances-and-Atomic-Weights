@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/sparql/queries/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .

ex:8_08-historical-standard-atomic-weights a sh:SPARQLExecutable, sh:SPARQLSelectExecutable;
  rdfs:comment """ Historical standard atomic weights
 Every standard atomic weight the Commission recommended for an element, oldest first, with its year. The current one has no deprecated flag.""";
  rdfs:label "Historical standard atomic weights";
  sh:prefixes _:sparql_examples_prefixes;
  sh:select """PREFIX chemrof: <https://w3id.org/chemrof/>
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT ?symbol ?year ?value ?lower ?upper ?deprecated WHERE {
  ?element chemrof:symbol ?symbol ;
    ciaaw:hasDeclaration ?declaration .
  ?declaration a ciaaw:StandardAtomicWeightDeclaration ;
    dcterms:issued ?year ;
    ciaaw:value ?quantity .
  OPTIONAL { ?quantity qudt:numericValue ?value }
  OPTIONAL { ?quantity qudt:lowerBound ?lower ; qudt:upperBound ?upper }
  OPTIONAL { ?declaration owl:deprecated ?deprecated }
}
ORDER BY ?symbol ?year""";
  schema:keywords "history", "standard atomic weight" .
