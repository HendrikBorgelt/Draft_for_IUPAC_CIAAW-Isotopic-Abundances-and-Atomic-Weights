# Elements
# Every element with its atomic number and symbol.
#+ summary: Elements
#+ tags:
#+ - elements
#+ - atomic number
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?z ?symbol ?name WHERE {
  ?element a ciaaw:ChemicalElement ;
    rdfs:label ?name ;
    ciaaw:hasSymbol ?symbol ;
    ciaaw:hasAtomicNumber ?z .
}
ORDER BY ?z
