# Elements with footnote g
# Elements whose current standard atomic weight carries note g, for materials outside the limits for normal material.
#+ summary: Elements with footnote g
#+ tags:
#+ - footnotes
#+ - elements
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?symbol ?name WHERE {
  ?element ciaaw:hasSymbol ?symbol ;
    ciaaw:hasAtomicNumber ?z ;
    rdfs:label ?name ;
    ciaaw:hasCurrentStandardAtomicWeight/ciaaw:hasFootnote/skos:notation "g" .
}
ORDER BY ?z
