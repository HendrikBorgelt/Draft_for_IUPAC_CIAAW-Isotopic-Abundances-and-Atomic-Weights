# Standard atomic weights
# The current declaration of each element, which is either an interval or a value with an uncertainty. Elements without a standard atomic weight are left out.
#+ summary: Standard atomic weights
#+ tags:
#+ - standard atomic weight
#+ - interval
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>

SELECT ?symbol ?lower ?upper ?value ?uncertainty WHERE {
  ?element ciaaw:hasSymbol ?symbol ;
    ciaaw:hasAtomicNumber ?z ;
    ciaaw:hasCurrentStandardAtomicWeight ?weight .
  OPTIONAL { ?weight ciaaw:hasLowerBound ?lower ; ciaaw:hasUpperBound ?upper }
  OPTIONAL { ?weight ciaaw:hasValue ?value ; ciaaw:hasStandardUncertainty ?uncertainty }
}
ORDER BY ?z
