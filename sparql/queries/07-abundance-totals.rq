# Total abundance per element
# Adds up the isotopes of each element. Elements given as intervals are left out, because intervals have no meaningful sum.
#+ summary: Total abundance per element
#+ tags:
#+ - abundance
#+ - totals
PREFIX chemrof: <https://w3id.org/chemrof/>
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT ?symbol (SUM(?amount) AS ?total) WHERE {
  ?element chemrof:symbol ?symbol ;
    ciaaw:hasIsotope/ciaaw:currentAbundance/ciaaw:value/qudt:numericValue ?amount .
  MINUS {
    ?element ciaaw:hasIsotope/ciaaw:currentAbundance/ciaaw:value/qudt:lowerBound ?bound .
  }
}
GROUP BY ?symbol
ORDER BY ?symbol
