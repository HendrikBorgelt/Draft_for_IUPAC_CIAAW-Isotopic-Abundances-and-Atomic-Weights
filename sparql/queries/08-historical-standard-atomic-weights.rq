# Historical standard atomic weights
# Every standard atomic weight the Commission recommended for an element, oldest first, with its year and its status: current, or superseded by a later one.
#+ summary: Historical standard atomic weights
#+ tags:
#+ - standard atomic weight
#+ - history
PREFIX ciaaw: <https://hendrikborgelt.github.io/Draft_for_IUPAC_CIAAW-Isotopic-Abundances-and-Atomic-Weights/ciaaw-draft#>

SELECT ?symbol ?year ?value ?lower ?upper ?status WHERE {
  ?element ciaaw:hasSymbol ?symbol ;
    ciaaw:hasDeclaration ?declaration .
  ?declaration a ciaaw:StandardAtomicWeightDeclaration ;
    ciaaw:hasStartValidity ?year ;
    ciaaw:hasStatus ?status .
  OPTIONAL { ?declaration ciaaw:hasValue ?value }
  OPTIONAL { ?declaration ciaaw:hasLowerBound ?lower ; ciaaw:hasUpperBound ?upper }
}
ORDER BY ?symbol ?year
