footnotes:g a ciaaw:Footnote ;
    rdfs:label "footnote g"@en ;
    skos:definition "Geological and biological materials are known in which the element has an isotopic composition outside the limits for normal material. The difference between the atomic weight of the element in such materials and that given in the table may exceed the stated uncertainty."@en ;
    skos:notation "g" ;
    prov:wasDerivedFrom <https://ciaaw.org/atomic-weights.htm> .

