footnotes:r a ciaaw:Footnote ;
    rdfs:label "footnote r"@en ;
    skos:definition "Range in isotopic composition of normal terrestrial material prevents a more precise standard atomic weight being given; the tabulated value and uncertainty should be applicable to normal material."@en ;
    skos:notation "r" ;
    prov:wasDerivedFrom <https://ciaaw.org/atomic-weights.htm> .

footnotes:m a ciaaw:Footnote ;
    rdfs:label "footnote m"@en ;
    skos:definition "Modified isotopic compositions may be found in commercially available material because the material has been subjected to some undisclosed or inadvertent isotopic fractionation. Substantial deviations in atomic weight of the element from that given in the table can occur."@en ;
    skos:notation "m" ;
    prov:wasDerivedFrom <https://ciaaw.org/atomic-weights.htm> .

