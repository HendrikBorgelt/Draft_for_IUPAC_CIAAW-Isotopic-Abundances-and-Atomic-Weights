ciaaw:note-r a ciaaw:Footnote ;
    skos:definition "Range in isotopic composition of normal terrestrial material prevents a more precise standard atomic weight being given; the tabulated value and uncertainty should be applicable to normal material."@en ;
    skos:notation "r" .

ciaaw:note-m a ciaaw:Footnote ;
    skos:definition "Modified isotopic compositions may be found in commercially available material because the material has been subjected to some undisclosed or inadvertent isotopic fractionation. Substantial deviations in atomic weight of the element from that given in the table can occur."@en ;
    skos:notation "m" .

ciaaw:StandardAtomicWeightDeclaration rdfs:comment "Ar°(E): either an interval (lowerBound/upperBound) or value with standardUncertainty." ;
    rdfs:subClassOf ciaaw:Declaration .

ciaaw:note-g a ciaaw:Footnote ;
    skos:definition "Geological and biological materials are known in which the element has an isotopic composition outside the limits for normal material. The difference between the atomic weight of the element in such materials and that given in the table may exceed the stated uncertainty."@en ;
    skos:notation "g" .

ciaaw:IsotopicAbundanceDeclaration rdfs:comment "Representative isotopic composition (amount fraction) of one isotope." ;
    rdfs:subClassOf ciaaw:Declaration .

